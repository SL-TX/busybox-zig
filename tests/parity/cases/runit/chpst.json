{
  "applet": "chpst",
  "cases": [
    {
      "name": "help",
      "argv": [
        "--help"
      ],
      "expect": {
        "exit": 0
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "no_args",
      "argv": [],
      "expect": {
        "exit": 1
