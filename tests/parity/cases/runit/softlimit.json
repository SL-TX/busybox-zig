{
  "applet": "softlimit",
  "cases": [
    {
      "name": "help",
      "argv": [
        "--help"
      ],
      "expect": {
        "exit": 0
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "no_args",
      "argv": [],
      "expect": {
        "exit": 1
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "run",
      "argv": [
        "<BB>",
        "echo",
        "hi"
      ],
      "expect": {
        "exit": 0,
        "stdout": "hi\n"
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "bad_number",
      "argv": [
        "-m",
        "bogus",
        "<BB>",
        "echo",
        "hi"
      ],
      "expect": {
        "exit": 1,
        "stderr": "softlimit: invalid number 'bogus'\n"
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "missing_prog",
      "argv": [
        "nosuchprog_zz"
      ],
      "expect": {
        "exit": 127,
        "stderr": "softlimit: can't execute 'nosuchprog_zz': No such file or directory\n"
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    },
    {
      "name": "invalid_option",
      "argv": [
        "-z"
      ],
      "expect": {
        "exit": 1
      },
      "files": {},
      "dirs": [],
      "stdin": null,
      "normalize": [],
      "requires": [],
      "env": {},
      "cwd": ".",
      "timeout_ms": 5000
    }
  ]
}
